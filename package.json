{
  "name": "moepictures",
  "version": "1.0.0",
  "description": "Moepictures is an image board for cute/moe anime girl art.",
  "main": "dist/server/server.js",
  "scripts": {
    "start": "npm run build && node --max-old-space-size=8192 dist/server/server.js",
    "dev": "rsbuild dev --config rsbuild.client.ts",
    "build": "npm run clean && rsbuild build --config rsbuild.client.ts && rsbuild build --config rsbuild.server.ts",
    "pm2": "pm2 start ecosystem.config.js --env production",
    "ssh": "dotenv -e .env -- sh -c 'ssh -i \"$SSH_KEY_PATH\" \"$SSH_USER\"@\"$SSH_HOST\"'",
    "sitemap": "node sitemap.ts",
    "clean": "del-cli ./dist"
  },
  "keywords": [
    "moe",
    "cute",
    "kawaii",
    "anime art"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Moebytes/Moepictures"
  },
  "author": "Moebytes",
  "license": "CC BY-NC 4.0",
